# Copy to .env. Setu AI runs on NVIDIA's API: get a key (starts with nvapi-) at https://build.nvidia.com.
# Without a key, Setu AI answers offline from the handbook and the user's records.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
PORT=8787
